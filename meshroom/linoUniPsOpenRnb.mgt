{
    "header": {
        "releaseVersion": "2026.1.0+develop",
        "fileVersion": "2.1",
        "nodesVersions": {
            "CameraInit": "12.1",
            "ExportImages": "1.1",
            "FeatureExtraction": "1.3",
            "FeatureMatching": "2.1",
            "ImageMatching": "2.1",
            "ImageSegmentationSam3": "2.0",
            "IntrinsicsTransforming": "1.1",
            "LINOUniPS": "2.1",
            "OpenRNb": "2.1",
            "SfMFilter": "2.0",
            "SfMTransfer": "2.2",
            "StructureFromMotion": "3.3"
        },
        "template": true
    },
    "graph": {
        "CameraInit_1": {
            "nodeType": "CameraInit",
            "position": [
                0,
                0
            ],
            "inputs": {}
        },
        "ExportImages_1": {
            "nodeType": "ExportImages",
            "position": [
                1800,
                0
            ],
            "inputs": {
                "input": "{IntrinsicsTransforming_1.input}",
                "target": "{IntrinsicsTransforming_1.output}",
                "masksFolders": [
                    "{ImageSegmentationSam3_1.output}"
                ],
                "outputFileType": "png"
            }
        },
        "FeatureExtraction_1": {
            "nodeType": "FeatureExtraction",
            "position": [
                600,
                0
            ],
            "inputs": {
                "input": "{ImageSegmentationSam3_1.input}",
                "masksFolder": "{ImageSegmentationSam3_1.output}"
            }
        },
        "FeatureExtraction_2": {
            "nodeType": "FeatureExtraction",
            "position": [
                499,
                153
            ],
            "inputs": {
                "input": "{SfMFilter_1.outputSfMData_selected}",
                "describerTypes": [
                    "tag16h5"
                ]
            }
        },
        "FeatureMatching_1": {
            "nodeType": "FeatureMatching",
            "position": [
                1000,
                0
            ],
            "inputs": {
                "input": "{ImageMatching_1.input}",
                "featuresFolders": "{ImageMatching_1.featuresFolders}",
                "imagePairsList": "{ImageMatching_1.output}",
                "describerTypes": [
                    "dspsift",
                    "tag16h5"
                ]
            }
        },
        "ImageMatching_1": {
            "nodeType": "ImageMatching",
            "position": [
                800,
                0
            ],
            "inputs": {
                "input": "{FeatureExtraction_1.input}",
                "featuresFolders": [
                    "{FeatureExtraction_1.output}",
                    "{FeatureExtraction_2.output}"
                ]
            }
        },
        "ImageSegmentationSam3_1": {
            "nodeType": "ImageSegmentationSam3",
            "position": [
                400,
                0
            ],
            "inputs": {
                "input": "{SfMFilter_1.outputSfMData_selected}",
                "prompt": "stone",
                "keepFilename": false,
                "extensionOut": "png"
            }
        },
        "IntrinsicsTransforming_1": {
            "nodeType": "IntrinsicsTransforming",
            "position": [
                1600,
                0
            ],
            "inputs": {
                "input": "{SfMTransfer_1.output}"
            }
        },
        "LINOUniPS_1": {
            "nodeType": "LINOUniPS",
            "position": [
                2000,
                0
            ],
            "inputs": {
                "inputSfm": "{ExportImages_1.outputSfMData}",
                "downscale": 2,
                "excludePoseReferenceImage": true,
                "maskPoseReferenceOnly": true
            }
        },
        "OpenRNb_1": {
            "nodeType": "OpenRNb",
            "position": [
                2200,
                0
            ],
            "inputs": {
                "inputNormalSfm": "{LINOUniPS_1.outputSfmDataNormal}",
                "inputMaskFolder": "{LINOUniPS_1.outputMaskFolder}",
                "maxSteps": 1000,
                "meshResolution": 512
            }
        },
        "SfMFilter_1": {
            "nodeType": "SfMFilter",
            "position": [
                200,
                0
            ],
            "inputs": {
                "inputFile": "{CameraInit_1.output}",
                "expression": "contains(path, \"all_leds\")"
            }
        },
        "SfMTransfer_1": {
            "nodeType": "SfMTransfer",
            "position": [
                1400,
                0
            ],
            "inputs": {
                "input": "{SfMFilter_1.inputFile}",
                "reference": "{StructureFromMotion_1.output}"
            }
        },
        "StructureFromMotion_1": {
            "nodeType": "StructureFromMotion",
            "position": [
                1200,
                0
            ],
            "inputs": {
                "input": "{FeatureMatching_1.input}",
                "featuresFolders": "{FeatureMatching_1.featuresFolders}",
                "matchesFolders": [
                    "{FeatureMatching_1.output}"
                ],
                "describerTypes": "{FeatureMatching_1.describerTypes}",
                "interFileExtension": ".abc"
            }
        }
    }
}